; Available external functions.
declare void @Print(i32)
declare void @PrintN(i32, ...)
declare void @Print_F(double)
declare void @PrintN_F(i32, ...)


define void @multiplication(i32 %5, i32 %6) {
1:
  %7 = alloca i32
  %8 = alloca i32
  %12 = alloca i32
  br label %2
2:
  store i32 %5, i32* %7
  store i32 %6, i32* %8
  br label %3
3:
  %9 = load i32, i32* %7
  %10 = load i32, i32* %8
  %11 = mul i32 %9, %10
  store i32 %11, i32* %12
  %13 = load i32, i32* %12
  call void  @Print(i32 %13)
  br label %4
4:
  ret void 
}

define void @main_Grobbit_16__() {
1:
  %5 = alloca i32
  %6 = alloca i32
  br label %2
2:
  br label %3
3:
  store i32 5, i32* %5
  store i32 3, i32* %6
  %7 = load i32, i32* %5
  %8 = load i32, i32* %6
  call void  @multiplication(i32 %7, i32 %8)
  br label %4
4:
  ret void 
}

